# ===== Cấu hình cho Docker Compose =====
# Copy file này thành .env rồi đổi mật khẩu trước khi chạy

MYSQL_ROOT_PASSWORD=doi_mat_khau_root
MYSQL_DATABASE=todo_app
MYSQL_USER=todo_user
MYSQL_PASSWORD=doi_mat_khau_app

# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=doi_thanh_chuoi_ngau_nhien

# Cookie đăng nhập chỉ gửi qua HTTPS. Chưa có HTTPS (demo localhost / IP LAN) → false
COOKIE_SECURE=false
